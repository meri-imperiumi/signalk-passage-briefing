{
  "name": "@meri-imperiumi/signalk-passage-briefing",
  "version": "0.12.1",
  "description": "Offshore passage daily briefing webapp for Signal K",
  "main": "plugin/index.js",
  "scripts": {
    "format": "npx @biomejs/biome check --use-editorconfig=true --write plugin/ tests/ bin/ public/",
    "lint": "npx @biomejs/biome check --use-editorconfig=true plugin/ public/",
    "test": "node --test \"tests/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/meri-imperiumi/signalk-passage-briefing.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-weather",
    "signalk-webapp"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/meri-imperiumi/signalk-passage-briefing/issues"
  },
  "homepage": "https://github.com/meri-imperiumi/signalk-passage-briefing#readme",
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Passage Briefing",
    "appIcon": "./icon-256.png",
    "screenshots": [
      "doc/here-brief.png"
    ],
    "requires": [
      "@meri-imperiumi/signalk-energy-predictor",
      "@meri-imperiumi/signalk-internet",
      "signalk-polar-management"
    ],
    "recommends": [
      "signalk-watch-schedule",
      "@meri-imperiumi/signalk-ships-time"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@openwaters/almanac": "^0.10.0",
    "@openwaters/maritime-zones": "^0.2.1",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.30.0"
  }
}
